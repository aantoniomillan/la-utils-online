<div class="uh-vacio" data-uh-reveal>
  <svg class="uh-vacio__luna" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path d="M44 8a26 26 0 1 0 12 36A22 22 0 0 1 44 8z" />
    <circle cx="26" cy="30" r="3" />
    <circle cx="36" cy="44" r="2" />
    <circle cx="20" cy="42" r="1.6" />
  </svg>
  <p class="uh-vacio__titulo">{{ titulo }}</p>
  <p class="uh-vacio__texto">{{ texto }}</p>
  {%- if ayuda != blank and request.design_mode -%}
    <p class="uh-vacio__ayuda">{{ ayuda }}</p>
  {%- endif -%}
  {%- if enlace != blank -%}
    <a class="uh-btn uh-btn--contorno" href="{{ enlace }}"><span class="uh-btn__texto">{{ enlace_texto }}</span></a>
  {%- endif -%}
</div>
