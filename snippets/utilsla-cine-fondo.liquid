      <defs>
        <radialGradient id="uc-f-salon-luz" cx=".5" cy=".72" r=".75">
          <stop offset="0" stop-color="#5A3A1C" /><stop offset=".45" stop-color="#261A17" /><stop offset="1" stop-color="#0F1220" />
        </radialGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#uc-f-salon-luz)" />
      <g data-uc-capa="0.4" fill="#FFDDA6">
        <circle cx="820" cy="120" r="5" opacity=".7" /><circle cx="980" cy="180" r="3" opacity=".5" />
        <circle cx="1120" cy="110" r="4" fill="#FF8A80" opacity=".6" /><circle cx="1280" cy="200" r="5" fill="#93D5FF" opacity=".55" />
        <circle cx="1420" cy="130" r="3" opacity=".6" /><circle cx="700" cy="220" r="3" fill="#7EE2B0" opacity=".5" />
        <circle cx="1040" cy="260" r="4" opacity=".45" />
      </g>
      <g data-uc-capa="1" fill="none" stroke="#FFDDA6" stroke-opacity=".38" stroke-width="2">
        <g transform="translate(380 0)">
          <path d="M330 760 420 250 510 760z" />
          <path d="M372 520h96M352 640h136M392 400h56" stroke-opacity=".2" />
          <path d="M420 760v70" />
