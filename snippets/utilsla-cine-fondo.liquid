        </g>
      </g>
      <path data-uc-capa="1.4" d="M0 800c240-30 520-40 800-30s560 30 800 10v120H0z" fill="url(#uc-f-fachada-nieve)" />
    </svg>
  {%- when 'ninos' -%}
    <svg class="uc-fondo" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id="uc-f-ninos-pared" cx=".55" cy=".35" r=".8">
          <stop offset="0" stop-color="#2A2A52" /><stop offset=".55" stop-color="#171C36" /><stop offset="1" stop-color="#0D1122" />
        </radialGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#uc-f-ninos-pared)" />
      <g data-uc-capa="0.5" fill="none" stroke-width="3" stroke-linecap="round">
        <path d="M720 160v40M703 170l34 20M703 190l34-20" stroke="#FFF4E0" />
        <path d="M960 120v52M937 133l46 26M937 159l46-26" stroke="#93D5FF" />
        <path d="M1180 230v36M1164 239l32 18M1164 257l32-18" stroke="#FFC778" />
        <path d="M860 300v30M847 307l26 16M847 323l26-16" stroke="#FF8A80" />
        <path d="M1080 360v44M1061 371l38 22M1061 393l38-22" stroke="#7EE2B0" />
        <path d="M620 300v28M608 307l24 14M608 321l24-14" stroke="#FFDDA6" />
      </g>
      <g data-uc-capa="1" fill="#070A14">
        <circle cx="640" cy="560" r="34" />
        <path d="M600 600c-16 40-20 120-14 220h108c6-100 2-180-14-220z" />
        <path d="M672 610 742 470" stroke="#070A14" stroke-width="22" stroke-linecap="round" />
        <circle cx="900" cy="610" r="28" />
        <path d="M868 642c-12 34-16 100-10 178h88c6-78 2-144-10-178z" />
        <path d="M926 650 990 540" stroke="#070A14" stroke-width="18" stroke-linecap="round" />
