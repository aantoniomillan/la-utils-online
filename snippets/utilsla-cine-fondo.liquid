      <defs>
        <linearGradient id="uc-f-fachada-cielo" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0B1426" /><stop offset=".7" stop-color="#1B2C4A" /><stop offset="1" stop-color="#2A3D5E" />
        </linearGradient>
        <linearGradient id="uc-f-fachada-nieve" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#C9D6E6" stop-opacity=".55" /><stop offset="1" stop-color="#E9EEF5" stop-opacity=".85" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#uc-f-fachada-cielo)" />
      <g data-uc-capa="0.3" fill="#E9EEF5">
        <circle cx="120" cy="90" r="2" opacity=".7" /><circle cx="300" cy="200" r="1.6" opacity=".6" /><circle cx="520" cy="60" r="2.2" opacity=".5" />
        <circle cx="1180" cy="80" r="1.8" opacity=".7" /><circle cx="1360" cy="190" r="2.4" opacity=".6" /><circle cx="1520" cy="70" r="1.6" opacity=".5" />
        <circle cx="240" cy="380" r="2" opacity=".5" /><circle cx="1440" cy="420" r="2" opacity=".5" />
