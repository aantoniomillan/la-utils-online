        <path d="M1180 700h400c20 0 30 12 30 30v70h-460v-70c0-18 10-30 30-30z" stroke-opacity=".24" />
      </g>
      <g data-uc-capa="1" fill="#FFC778" transform="translate(380 0)">
        <circle cx="400" cy="380" r="4" /><circle cx="452" cy="470" r="4" fill="#FF8A80" />
        <circle cx="384" cy="560" r="4" fill="#7EE2B0" /><circle cx="470" cy="610" r="4" />
        <circle cx="360" cy="690" r="4" fill="#93D5FF" /><circle cx="440" cy="700" r="4" fill="#FF8A80" />
      </g>
    </svg>
  {%- when 'fachada' -%}
