        <rect x="640" y="520" width="70" height="70" rx="3" fill="#FFC778" opacity=".55" />
        <rect x="890" y="520" width="70" height="70" rx="3" fill="#FFC778" opacity=".55" />
        <g fill="#FFF4E0">
          <circle cx="620" cy="470" r="5" opacity=".8" /><circle cx="740" cy="430" r="4" fill="#FF6B6B" opacity=".8" />
          <circle cx="860" cy="410" r="5" fill="#5EDC9F" opacity=".8" /><circle cx="980" cy="470" r="4" opacity=".8" />
