{%- comment -%}
  UtilsLA · Portada cinematográfica del proyector de luces navideñas.
  Marcado y datos. La animación vive en assets/utilsla-cine.js y el estilo en assets/utilsla-cine.css.

  Fotos: secuencia de 6 fotos a pantalla completa. Cada una usa la imagen elegida en el editor o, si no hay,
  assets/escena-1.jpg ... assets/escena-6.jpg. Se precargan al abrir la página.
  Proyector: modelo 3D (assets/utilsla-proyector3d.js, three.js). Si existe assets/proyector.glb se carga; si no, se
  construye por código. En móviles lentos o sin WebGL se usa la imagen: ajuste "Imagen del proyector" o assets/proyector.png.
  Motivos de la proyección: assets/motivo-copo.png, -santa, -arbol, -regalo, -estrella, -baston (blanco sobre transparente);
  si no existen se dibujan en canvas.
{%- endcomment -%}

{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = all_products['proyector-de-luces-navidenas']
  endif

  assign hay_producto = false
  if p.id != blank and p.variants.size > 0
    assign hay_producto = true
  endif

  assign v_uno = p.variants | first
  assign recomendado = section.settings.pack_recomendado | default: 2
  assign i_rec = recomendado | minus: 1
  assign v_sel = p.variants[i_rec]
  if v_sel == blank or v_sel.available == false
    assign v_sel = p.selected_or_first_available_variant
  endif

  assign min_unidad = v_uno.price
  for var in p.variants
    assign uds = var.title | split: ' ' | first | times: 1
    if uds < 1
      assign uds = 1
    endif
    assign por_unidad = var.price | times: 1.0 | divided_by: uds | round
    if por_unidad < min_unidad
      assign min_unidad = por_unidad
    endif
  endfor

  assign base_assets = 'utilsla-cine.css' | asset_url | split: 'utilsla-cine.css' | first

  assign f_txt = section.settings.fuente_texto
  assign f_txt_med = f_txt | font_modify: 'weight', '500'

  assign con_carga = section.settings.mostrar_carga
  if request.design_mode
    assign con_carga = false
  endif
-%}

<style>
  {{ f_txt | font_face: font_display: 'swap' }}
  {{ f_txt_med | font_face: font_display: 'swap' }}
  #uc-{{ section.id }} {
    --uc-f-txt: {{ f_txt.family }}, {{ f_txt.fallback_families }};
  }
</style>
{{ 'utilsla-cine.css' | asset_url | stylesheet_tag }}

<script>
  (function () {
    var html = document.documentElement;
    html.classList.add('uc-js');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) html.classList.add('uc-motion');
    // Red de seguridad: si la animación no llega a arrancar, el contenido se muestra igual.
    setTimeout(function () {
      if (window.UtilsCine) return;
      html.classList.remove('uc-motion');
      var carga = document.querySelector('.uc-carga');
      if (carga) carga.remove();
    }, 6000);
  })();
</script>

<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
<script src="{{ 'utilsla-cine.js' | asset_url }}" defer></script>

<div
  id="uc-{{ section.id }}"
  class="uc"
  data-uc
  data-assets="{{ base_assets }}"
  data-carrito="{{ routes.cart_url }}"
  data-carrito-add="{{ routes.cart_add_url }}"
  {% if request.design_mode %}data-editor{% endif %}
>
  {%- if con_carga -%}
    <div class="uc-carga" data-uc-carga aria-hidden="true">
      <div class="uc-carga__centro">
        <svg class="uc-carga__copo" viewBox="-12 -12 24 24" aria-hidden="true">
          <path d="M0-10V10M-8.66-5 8.66 5M-8.66 5 8.66-5M0-6l-2.4-2.4M0-6l2.4-2.4M0 6l-2.4 2.4M0 6l2.4 2.4" />
        </svg>
        <p class="uc-carga__texto">Encendiendo la Navidad</p>
        <p class="uc-carga__cifra"><span data-uc-carga-cifra>0</span><span class="uc-carga__pct">%</span></p>
        <span class="uc-carga__pista"><span data-uc-carga-barra></span></span>
      </div>
    </div>
  {%- endif -%}

  <div class="uc-progreso" aria-hidden="true"><span data-uc-progreso></span></div>

  {%- comment -%}
    Escenario único fijado: hero → proyector a un lado + proyección → escenas de uso.
    Todo ocurre dentro de un solo marco fijado, así que entre las partes no hay cortes ni cortinas.
  {%- endcomment -%}
  <section class="uc-escenario" data-uc-escenario aria-label="Proyector de luces navideñas">
    <div class="uc-marco" data-uc-marco>
      <div class="uc-halo" data-uc-halo aria-hidden="true"></div>

      <div class="uc-proy" data-uc-proy aria-hidden="true">
        <canvas class="uc-proy__lienzo" data-uc-proy-lienzo></canvas>
      </div>
      <div class="uc-rayo" data-uc-rayo aria-hidden="true"></div>

      <div class="uc-hero">
        <p class="uc-eyebrow" data-uc-intro>UtilsLA · Proyector de luces navideñas</p>
        <h1 class="uc-hero__titulo" data-uc-titulo>{{ section.settings.titulo }}</h1>
        <p class="uc-hero__sub" data-uc-intro>{{ section.settings.subtitulo }}</p>
        {%- if hay_producto -%}
          <div class="uc-hero__accion" data-uc-intro>
            <a class="uc-btn uc-btn--luz" href="#uc-packs-{{ section.id }}" data-uc-ancla>
              <span>Elegir pack</span>
              <svg class="uc-btn__flecha" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
            </a>
            <p class="uc-hero__precio">Desde <strong>{{ min_unidad | money }}</strong> la unidad</p>
          </div>
        {%- endif -%}
        <p class="uc-desliza" data-uc-intro data-uc-desliza><span class="uc-desliza__linea" aria-hidden="true"></span>Desliza para descubrir</p>
      </div>

      <canvas
        class="uc-3d"
        data-uc-3d
        data-three="{{ 'utilsla-proyector3d.js' | asset_url }}"
        aria-hidden="true"
      ></canvas>

      <div class="uc-proyector" data-uc-proyector>
        <span class="uc-lente-brillo" data-uc-lente aria-hidden="true"></span>
        {%- if section.settings.imagen_proyector != blank -%}
          {{
            section.settings.imagen_proyector
            | image_url: width: 600
            | image_tag:
              widths: '240, 360, 480, 600',
              sizes: '(min-width: 990px) 220px, 150px',
              loading: 'eager',
              class: 'uc-proyector__img',
              alt: p.title
          }}
        {%- else -%}
          <svg class="uc-proyector__svg" data-uc-proyector-svg viewBox="0 0 200 172" role="img" aria-label="{{ p.title | default: 'Proyector de luces navideñas' | escape }}">
            <defs>
              <linearGradient id="uc-cuerpo-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#34425F" /><stop offset=".55" stop-color="#1B2640" /><stop offset="1" stop-color="#0B1120" />
              </linearGradient>
              <radialGradient id="uc-lente-{{ section.id }}" cx=".42" cy=".38" r=".7">
                <stop offset="0" stop-color="#FFF6E6" /><stop offset=".35" stop-color="#FFC778" /><stop offset=".78" stop-color="#6D4214" /><stop offset="1" stop-color="#140D05" />
              </radialGradient>
            </defs>
            <ellipse cx="100" cy="162" rx="64" ry="7" fill="#000" opacity=".4" />
            <path d="M100 158c0 9 34 9 100 9" fill="none" stroke="#1C2742" stroke-width="3" stroke-linecap="round" />
            <path d="M72 148h56l-7 12H79z" fill="#121A2B" />
            <rect x="48" y="60" width="104" height="94" rx="42" fill="url(#uc-cuerpo-{{ section.id }})" />
            <path d="M63 96c7-20 22-28 40-30" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width="3" stroke-linecap="round" />
            <ellipse cx="100" cy="64" rx="41" ry="16" fill="#0A0F1C" stroke="#3A4866" stroke-width="2" />
            <ellipse class="uc-proyector__lente" cx="100" cy="62" rx="30" ry="11" fill="url(#uc-lente-{{ section.id }})" />
          </svg>
        {%- endif -%}
      </div>

      <div class="uc-motivos" data-uc-motivos>
        <p class="uc-eyebrow uc-motivos__eyebrow">Lo que verás en la pared</p>
        <ol class="uc-motivos__lista">
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Copos de nieve</h2>
            <p class="uc-motivo__texto">Una nevada que no se derrite.</p>
          </li>
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Papá Noel</h2>
            <p class="uc-motivo__texto">De visita antes de Nochebuena.</p>
          </li>
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Árboles</h2>
            <p class="uc-motivo__texto">Un bosque entero en la fachada.</p>
          </li>
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Regalos</h2>
            <p class="uc-motivo__texto">La ilusión, antes de abrirlos.</p>
          </li>
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Estrellas</h2>
            <p class="uc-motivo__texto">Un cielo de Navidad en el techo.</p>
          </li>
          <li class="uc-motivo" data-uc-motivo>
            <h2 class="uc-motivo__titulo">Bastones</h2>
            <p class="uc-motivo__texto">Rayas de caramelo por toda la pared.</p>
          </li>
        </ol>
      </div>

      <div class="uc-ctl" data-uc-ctl role="group" aria-label="Controles de la proyección">
        <div class="uc-ctl__fila uc-ctl__nav">
          <button type="button" class="uc-ctl__btn" data-uc-prev aria-label="Efecto anterior">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" /></svg>
          </button>
          <p class="uc-ctl__estado" aria-live="polite"><span data-uc-nombre>Copos de nieve</span><span class="uc-ctl__cuenta"><span data-uc-cuenta>01</span> / 06</span></p>
          <button type="button" class="uc-ctl__btn" data-uc-next aria-label="Efecto siguiente">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4 6 6-6 6" /></svg>
          </button>
        </div>
        <div class="uc-ctl__fila uc-ctl__ajustes">
          <button type="button" class="uc-ctl__btn uc-ctl__giro" data-uc-giro aria-pressed="true" aria-label="Parar el giro de la proyección">
            <svg class="uc-ctl__i-parar" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10M13 5v10" /></svg>
            <svg class="uc-ctl__i-girar" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.5v11l9-5.5z" /></svg>
          </button>
          <div class="uc-ctl__grupo" role="group" aria-label="Velocidad">
            <button type="button" class="uc-ctl__chip" data-uc-vel="0.5" aria-pressed="false" aria-label="Velocidad lenta">0,5×</button>
            <button type="button" class="uc-ctl__chip" data-uc-vel="1" aria-pressed="true" aria-label="Velocidad normal">1×</button>
            <button type="button" class="uc-ctl__chip" data-uc-vel="2" aria-pressed="false" aria-label="Velocidad rápida">2×</button>
          </div>
        </div>
        <div class="uc-ctl__fila uc-ctl__colores" role="group" aria-label="Color de la luz">
          <button type="button" class="uc-ctl__color uc-ctl__color--multi" data-uc-color="multi" aria-pressed="true" aria-label="Multicolor"></button>
          <button type="button" class="uc-ctl__color uc-ctl__color--calido" data-uc-color="calido" aria-pressed="false" aria-label="Blanco cálido"></button>
          <button type="button" class="uc-ctl__color uc-ctl__color--rojo" data-uc-color="rojo" aria-pressed="false" aria-label="Rojo"></button>
          <button type="button" class="uc-ctl__color uc-ctl__color--verde" data-uc-color="verde" aria-pressed="false" aria-label="Verde"></button>
          <button type="button" class="uc-ctl__color uc-ctl__color--azul" data-uc-color="azul" aria-pressed="false" aria-label="Azul"></button>
        </div>
      </div>
    </div>

    {%- comment -%}
      Secuencia de fotos a pantalla completa. Cada foto usa, por este orden: la imagen elegida en el editor
      o assets/escena-N.jpg (N de 1 a 6). Si no hay ninguna, se ve un fondo oscuro con la frase.
    {%- endcomment -%}
    <section class="uc-fotos" data-uc-fotos aria-label="Momentos de Navidad en casa">
      <div class="uc-fotos__marco" data-uc-fotos-marco>
        {%- for n in (1..6) -%}
          {%- liquid
            assign k_img = 'imagen_' | append: n
            assign k_txt = 'frase_' | append: n
            assign img = section.settings[k_img]
            assign frase = section.settings[k_txt]
          -%}
          <article class="uc-foto uc-foto--{{ n }}" data-uc-foto {% if img == blank %}data-asset="escena-{{ n }}.jpg"{% endif %}>
            <div class="uc-foto__mascara" data-uc-mascara>
              <div class="uc-foto__contra" data-uc-contra>
                <div class="uc-foto__media" data-uc-foto-media>
                  {%- if img != blank -%}
                    {{
                      img
                      | image_url: width: 2000
                      | image_tag:
                        widths: '750, 1200, 1600, 2000',
                        sizes: '100vw',
                        loading: 'eager',
                        decoding: 'async',
                        class: 'uc-foto__img',
                        alt: ''
                    }}
                  {%- endif -%}
                </div>
                <span class="uc-foto__velo" aria-hidden="true"></span>
              </div>
            </div>
            <div class="uc-foto__texto">
              <p class="uc-foto__num" aria-hidden="true">0{{ n }} / 06</p>
              <p class="uc-foto__frase" data-uc-frase>{{ frase }}</p>
            </div>
            {%- if request.design_mode and img == blank -%}
              <p class="uc-foto__aviso">Foto {{ n }}: elige una imagen en los ajustes o sube assets/escena-{{ n }}.jpg</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
        <span class="uc-fotos__velo" data-uc-velo aria-hidden="true"></span>
      </div>
    </section>
  </section>

  {%- comment -%} Cómo se usa {%- endcomment -%}
  <section class="uc-pasos" data-uc-pasos aria-labelledby="uc-pasos-titulo-{{ section.id }}">
    <div class="uc-contenedor">
      <p class="uc-eyebrow uc-eyebrow--oscuro">Cómo se usa</p>
      <h2 class="uc-h2" id="uc-pasos-titulo-{{ section.id }}" data-uc-lineas>Tres gestos y listo.</h2>
      <ol class="uc-pasos__lista">
        <li class="uc-paso" data-uc-paso="usb">
          <svg class="uc-paso__icono" viewBox="0 0 96 64" aria-hidden="true">
            <rect class="uc-paso__trazo" x="58" y="18" width="30" height="28" rx="5" />
            <rect class="uc-paso__trazo" x="64" y="27" width="18" height="10" rx="1.5" />
            <g data-uc-anim="enchufe">
              <path class="uc-paso__trazo" d="M4 32h22" />
              <rect class="uc-paso__trazo" x="26" y="24" width="18" height="16" rx="3" />
              <rect class="uc-paso__relleno" x="44" y="28" width="14" height="8" rx="1" />
            </g>
          </svg>
          <span class="uc-paso__num" aria-hidden="true">1</span>
          <h3 class="uc-paso__titulo">Enchúfalo</h3>
          <p class="uc-paso__texto">A cualquier cargador USB.</p>
        </li>
        <li class="uc-paso" data-uc-paso="orienta">
          <svg class="uc-paso__icono" viewBox="0 0 96 64" aria-hidden="true">
            <path class="uc-paso__trazo uc-paso__trazo--suave" d="M8 8h80" />
            <g data-uc-anim="orienta" style="transform-origin: 48px 52px">
              <rect class="uc-paso__trazo" x="34" y="30" width="28" height="24" rx="10" />
              <ellipse class="uc-paso__trazo" cx="48" cy="30" rx="10" ry="4" />
              <path class="uc-paso__trazo uc-paso__trazo--suave" d="M42 24 30 10M54 24l12-14" />
            </g>
          </svg>
          <span class="uc-paso__num" aria-hidden="true">2</span>
          <h3 class="uc-paso__titulo">Oriéntalo</h3>
          <p class="uc-paso__texto">Hacia la pared, la fachada o el techo.</p>
        </li>
        <li class="uc-paso" data-uc-paso="listo">
          <svg class="uc-paso__icono" viewBox="0 0 96 64" aria-hidden="true">
            <g data-uc-anim="rayos" style="transform-origin: 48px 34px">
              <path class="uc-paso__trazo uc-paso__trazo--luz" d="M48 6v8M48 54v8M20 34h8M68 34h8M28 14l6 6M68 14l-6 6M28 54l6-6M68 54l-6-6" />
            </g>
            <path class="uc-paso__trazo" d="M48 22v24M37.6 28l20.8 12M37.6 40l20.8-12" />
          </svg>
          <span class="uc-paso__num" aria-hidden="true">3</span>
          <h3 class="uc-paso__titulo">Listo</h3>
          <p class="uc-paso__texto">En un minuto, la Navidad encendida.</p>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%} Packs reales del producto {%- endcomment -%}
  <section class="uc-packs" id="uc-packs-{{ section.id }}" data-uc-packs aria-labelledby="uc-packs-titulo-{{ section.id }}">
    <div class="uc-contenedor uc-packs__rejilla">
      <div class="uc-packs__intro">
        <p class="uc-eyebrow uc-eyebrow--oscuro">Packs</p>
        <h2 class="uc-h2" id="uc-packs-titulo-{{ section.id }}" data-uc-lineas>Elige tu pack.</h2>
        <p class="uc-packs__lead">Uno para el salón, otro para la fachada y uno para regalar.</p>
        <ul class="uc-confianza">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>
            Envío gratis a España, Francia y Alemania
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
            14 días de devolución
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
            Pago seguro
          </li>
        </ul>
      </div>

      {%- if hay_producto -%}
        {%- render 'utilsla-packs', producto: p, recomendado: recomendado -%}
      {%- elsif request.design_mode -%}
        <p class="uc-packs__aviso">Elige en los ajustes de la sección un producto publicado en el canal Tienda online para mostrar los packs.</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} Cierre {%- endcomment -%}
  <section class="uc-final" data-uc-final aria-labelledby="uc-final-titulo-{{ section.id }}">
    <span class="uc-final__fondo" data-uc-final-fondo aria-hidden="true"></span>
    <span class="uc-final__copos" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <div class="uc-contenedor uc-final__centro">
      <h2 class="uc-final__titulo" id="uc-final-titulo-{{ section.id }}" data-uc-lineas>Esta Navidad, enciende tu casa.</h2>
      {%- if hay_producto -%}
        <a class="uc-btn uc-btn--luz" href="#uc-packs-{{ section.id }}" data-uc-ancla>
          <span>Elegir pack</span>
          <svg class="uc-btn__flecha" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg>
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- if hay_producto and p.available -%}
    <div class="uc-fijo" data-uc-fijo>
      <p class="uc-fijo__info">
        <span class="uc-fijo__nombre" data-uc-fijo-nombre>{{ v_sel.title }}</span>
        <strong class="uc-fijo__precio" data-uc-fijo-precio>{{ v_sel.price | money }}</strong>
      </p>
      <button type="button" class="uc-btn uc-btn--luz uc-fijo__boton" data-uc-fijo-boton tabindex="-1">Añadir al carrito</button>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "UtilsLA cine",
  "tag": "div",
  "class": "uc-seccion",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "number", "id": "pack_recomendado", "label": "Pack recomendado (posición de la variante)", "default": 2 },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "La Navidad, <em>proyectada</em> en tu casa." },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "Copos de nieve y figuras navideñas sobre paredes, fachadas y techos. Se enchufa por USB y está listo en un minuto." },
    { "type": "checkbox", "id": "mostrar_carga", "label": "Pantalla de carga", "default": true },
    { "type": "header", "content": "Tipografía" },
    { "type": "font_picker", "id": "fuente_texto", "label": "Texto", "default": "instrument_sans_n4" },
    { "type": "header", "content": "Proyector" },
    { "type": "image_picker", "id": "imagen_proyector", "label": "Imagen del proyector", "info": "PNG con fondo transparente. También puedes subir assets/proyector.png." },
    { "type": "header", "content": "Foto 1" },
    { "type": "image_picker", "id": "imagen_1", "label": "Imagen", "info": "O sube assets/escena-1.jpg" },
    { "type": "text", "id": "frase_1", "label": "Frase", "default": "Una noche de salón, con el árbol encendido." },
    { "type": "header", "content": "Foto 2" },
