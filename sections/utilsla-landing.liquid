    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu casa, iluminada de Navidad en un minuto" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Proyecta copos de nieve y figuras navideñas sobre paredes, fachadas y techos." },
    { "type": "number", "id": "pack_recomendado", "label": "Pack recomendado (posición de la variante)", "default": 2 },
    { "type": "select", "id": "destino", "label": "Al comprar, ir a", "options": [{ "value": "carrito", "label": "Carrito" }, { "value": "pago", "label": "Pago directo" }], "default": "carrito" }
  ],
  "presets": [{ "name": "UtilsLA portada" }]
}
{% endschema %}
