{%- assign p = section.settings.product -%}
{%- if p == blank -%}{%- assign p = all_products['minirastreador'] -%}{%- endif -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- assign d2 = section.settings.descuento2 -%}
{%- assign d3 = section.settings.descuento3 -%}
{%- assign f2 = 100 | minus: d2 | times: 2 -%}
{%- assign f3 = 100 | minus: d3 | times: 3 -%}
{%- assign precio1 = v.price -%}
{%- assign precio2 = v.price | times: f2 | divided_by: 100 -%}
{%- assign precio3 = v.price | times: f3 | divided_by: 100 -%}
{%- assign unidad2 = precio2 | divided_by: 2 -%}
{%- assign unidad3 = precio3 | divided_by: 3 -%}
{%- assign ahorro2 = v.price | times: 2 | minus: precio2 -%}
{%- assign ahorro3 = v.price | times: 3 | minus: precio3 -%}
{%- assign urlCompra = routes.cart_url | append: '/' | append: v.id | append: ':' -%}

<style>
  #ul-{{ section.id }} {
    --ul-pizarra: #17354D;
    --ul-tornasol: #2A8C7F;
    --ul-tornasolOsc: #1F6E64;
    --ul-cielo: #EAF2F6;
    --ul-papel: #FFFFFF;
    --ul-gris: #5E7080;
    --ul-linea: #D5E1E8;
    color: var(--ul-pizarra);
    font-family: var(--font-body--family);
  }
  #ul-{{ section.id }} * { box-sizing: border-box; }
  #ul-{{ section.id }} .ul-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  #ul-{{ section.id }} h1, #ul-{{ section.id }} h2, #ul-{{ section.id }} h3 { color: var(--ul-pizarra); margin: 0; letter-spacing: -0.02em; }
  #ul-{{ section.id }} p { margin: 0; }

  #ul-{{ section.id }} .ul-hero { background: var(--ul-cielo); padding: 56px 0 64px; overflow: hidden; }
  #ul-{{ section.id }} .ul-hero .ul-wrap { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; }
  #ul-{{ section.id }} .ul-hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.04; font-weight: 700; max-width: 13ch; }
  #ul-{{ section.id }} .ul-sub { font-size: 1.125rem; line-height: 1.55; color: var(--ul-gris); margin-top: 18px; max-width: 42ch; }
  #ul-{{ section.id }} .ul-specs { display: flex; gap: 0; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--ul-linea); border-bottom: 1px solid var(--ul-linea); }
  #ul-{{ section.id }} .ul-specs div { flex: 1; padding: 16px 0; }
  #ul-{{ section.id }} .ul-specs div + div { padding-left: 20px; border-left: 1px solid var(--ul-linea); }
  #ul-{{ section.id }} .ul-specs dt { font-size: 1.6rem; font-weight: 700; line-height: 1.1; }
  #ul-{{ section.id }} .ul-specs dd { margin: 4px 0 0; font-size: 0.875rem; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-accion { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; margin-top: 32px; }
  #ul-{{ section.id }} .ul-desde { font-size: 0.95rem; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-desde strong { color: var(--ul-pizarra); font-size: 1.1rem; }

  #ul-{{ section.id }} .ul-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; border-radius: 999px; background: var(--ul-tornasol); color: #fff; font-weight: 600; font-size: 1rem; text-decoration: none; border: 0; cursor: pointer; transition: background-color .2s ease, transform .15s ease; }
  #ul-{{ section.id }} .ul-btn:hover { background: var(--ul-tornasolOsc); }
  #ul-{{ section.id }} .ul-btn:active { transform: scale(0.98); }
  #ul-{{ section.id }} .ul-btn:focus-visible, #ul-{{ section.id }} .ul-pack:focus-within, #ul-{{ section.id }} .ul-thumb:focus-visible, #ul-{{ section.id }} summary:focus-visible { outline: 3px solid var(--ul-pizarra); outline-offset: 3px; }

  #ul-{{ section.id }} .ul-escena { position: relative; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; background: var(--ul-papel); box-shadow: 0 30px 60px -30px rgba(23, 53, 77, 0.35); }
  #ul-{{ section.id }} .ul-escena img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #ul-{{ section.id }} .ul-ruta { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  #ul-{{ section.id }} .ul-ruta .ul-linea { fill: none; stroke: var(--ul-tornasol); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 6 9; filter: drop-shadow(0 1px 2px rgba(0,0,0,.35)); }
  #ul-{{ section.id }} .ul-ruta .ul-trazo { fill: none; stroke: #fff; stroke-width: 10; stroke-dasharray: 900; stroke-dashoffset: 900; animation: ul-dibujar 2.2s ease-out .3s forwards; }
  #ul-{{ section.id }} .ul-punto { fill: var(--ul-tornasol); opacity: 0; animation: ul-aparecer .3s ease-out 2.4s forwards; }
  #ul-{{ section.id }} .ul-onda { fill: none; stroke: var(--ul-tornasol); stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; animation: ul-onda 1.8s ease-out 2.5s 3; }
  #ul-{{ section.id }} .ul-palomar { fill: var(--ul-pizarra); }
  @keyframes ul-dibujar { to { stroke-dashoffset: 0; } }
  @keyframes ul-aparecer { to { opacity: 1; } }
  @keyframes ul-onda { 0% { opacity: .7; transform: scale(1); } 100% { opacity: 0; transform: scale(3.2); } }

  #ul-{{ section.id }} .ul-confianza { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 20px; padding: 0; list-style: none; font-size: 0.9rem; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-confianza li { display: flex; align-items: center; gap: 8px; }
  #ul-{{ section.id }} .ul-confianza svg { flex: none; color: var(--ul-tornasol); }

  #ul-{{ section.id }} .ul-compra { padding: 80px 0; scroll-margin-top: 80px; }
  #ul-{{ section.id }} .ul-compra .ul-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  #ul-{{ section.id }} .ul-galeria { position: sticky; top: 96px; }
  #ul-{{ section.id }} .ul-principal { aspect-ratio: 1 / 1; border-radius: 20px; background: var(--ul-cielo); overflow: hidden; }
  #ul-{{ section.id }} .ul-principal img { width: 100%; height: 100%; object-fit: contain; transition: opacity .25s ease; }
  #ul-{{ section.id }} .ul-thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; }
  #ul-{{ section.id }} .ul-thumb { flex: none; width: 68px; height: 68px; padding: 0; border-radius: 12px; border: 2px solid transparent; background: var(--ul-cielo); overflow: hidden; cursor: pointer; }
  #ul-{{ section.id }} .ul-thumb[aria-current="true"] { border-color: var(--ul-pizarra); }
  #ul-{{ section.id }} .ul-thumb img { width: 100%; height: 100%; object-fit: cover; }

  #ul-{{ section.id }} .ul-compra h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); line-height: 1.1; }
  #ul-{{ section.id }} .ul-compra .ul-sub { margin-top: 10px; font-size: 1rem; }
  #ul-{{ section.id }} .ul-packs { border: 0; margin: 28px 0 0; padding: 0; display: grid; gap: 12px; }
  #ul-{{ section.id }} .ul-pack { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; padding: 18px 20px; border: 1.5px solid var(--ul-linea); border-radius: 16px; cursor: pointer; transition: border-color .2s ease, background-color .2s ease; }
  #ul-{{ section.id }} .ul-pack input { position: absolute; opacity: 0; pointer-events: none; }
  #ul-{{ section.id }} .ul-radio { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ul-linea); display: grid; place-items: center; transition: border-color .2s ease; }
  #ul-{{ section.id }} .ul-radio::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--ul-tornasol); transform: scale(0); transition: transform .2s ease; }
  #ul-{{ section.id }} .ul-pack:has(input:checked) { border-color: var(--ul-tornasol); background: #F2F9F8; }
  #ul-{{ section.id }} .ul-pack:has(input:checked) .ul-radio { border-color: var(--ul-tornasol); }
  #ul-{{ section.id }} .ul-pack:has(input:checked) .ul-radio::after { transform: scale(1); }
  #ul-{{ section.id }} .ul-pack-nombre { font-weight: 600; font-size: 1.05rem; }
  #ul-{{ section.id }} .ul-pack-detalle { font-size: 0.875rem; color: var(--ul-gris); margin-top: 2px; }
  #ul-{{ section.id }} .ul-pack-precio { text-align: right; font-weight: 700; font-size: 1.15rem; }
  #ul-{{ section.id }} .ul-pack-precio s { display: block; font-weight: 400; font-size: 0.85rem; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-etiqueta { position: absolute; top: -11px; right: 18px; padding: 3px 10px; border-radius: 999px; background: var(--ul-pizarra); color: #fff; font-size: 0.75rem; font-weight: 600; }
  #ul-{{ section.id }} .ul-ahorro { color: var(--ul-tornasolOsc); font-weight: 600; }
  #ul-{{ section.id }} .ul-comprar { width: 100%; margin-top: 20px; min-height: 58px; font-size: 1.05rem; }
  #ul-{{ section.id }} .ul-nota { margin-top: 14px; font-size: 0.875rem; color: var(--ul-gris); line-height: 1.5; }
  #ul-{{ section.id }} .ul-garantias { list-style: none; margin: 20px 0 0; padding: 18px 0 0; border-top: 1px solid var(--ul-linea); display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  #ul-{{ section.id }} .ul-garantias li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.875rem; line-height: 1.4; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-garantias strong { display: block; color: var(--ul-pizarra); font-size: 0.925rem; }
  #ul-{{ section.id }} .ul-garantias svg { flex: none; margin-top: 2px; color: var(--ul-tornasol); }

  #ul-{{ section.id }} .ul-pasos { background: var(--ul-pizarra); color: #fff; padding: 72px 0; }
  #ul-{{ section.id }} .ul-pasos h2 { color: #fff; font-size: clamp(1.8rem, 3.5vw, 2.4rem); }
  #ul-{{ section.id }} .ul-pasos ol { list-style: none; counter-reset: paso; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 36px 0 0; padding: 0; }
  #ul-{{ section.id }} .ul-pasos li { counter-increment: paso; border-top: 1px solid rgba(255, 255, 255, 0.25); padding-top: 18px; }
  #ul-{{ section.id }} .ul-pasos li::before { content: counter(paso); display: block; font-size: 2.6rem; font-weight: 700; line-height: 1; color: #7FC7BC; }
  #ul-{{ section.id }} .ul-pasos h3 { color: #fff; font-size: 1.2rem; margin-top: 14px; }
  #ul-{{ section.id }} .ul-pasos p { color: rgba(255, 255, 255, 0.78); margin-top: 6px; line-height: 1.5; }

  #ul-{{ section.id }} .ul-faq { padding: 72px 0 96px; }
  #ul-{{ section.id }} .ul-faq .ul-wrap { max-width: 760px; }
  #ul-{{ section.id }} .ul-faq h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin-bottom: 20px; }
  #ul-{{ section.id }} details { border-bottom: 1px solid var(--ul-linea); }
  #ul-{{ section.id }} summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-weight: 600; font-size: 1.05rem; cursor: pointer; }
  #ul-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #ul-{{ section.id }} summary::after { content: "+"; font-size: 1.5rem; font-weight: 400; color: var(--ul-tornasol); transition: transform .2s ease; }
  #ul-{{ section.id }} details[open] summary::after { transform: rotate(45deg); }
  #ul-{{ section.id }} details p { padding: 0 0 20px; color: var(--ul-gris); line-height: 1.6; max-width: 62ch; }
  #ul-{{ section.id }} details a { color: var(--ul-tornasolOsc); }

  #ul-{{ section.id }} .ul-barra { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: none; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); background: var(--ul-papel); border-top: 1px solid var(--ul-linea); box-shadow: 0 -8px 24px -12px rgba(23, 53, 77, 0.25); transform: translateY(110%); transition: transform .3s ease; }
  #ul-{{ section.id }} .ul-barra.ul-visible { transform: translateY(0); }
  #ul-{{ section.id }} .ul-barra p { font-size: 0.9rem; color: var(--ul-gris); }
  #ul-{{ section.id }} .ul-barra strong { display: block; color: var(--ul-pizarra); font-size: 1rem; }
  #ul-{{ section.id }} .ul-barra .ul-btn { min-height: 46px; padding: 0 22px; }

  @media (max-width: 860px) {
    #ul-{{ section.id }} .ul-hero { padding: 32px 0 48px; }
    #ul-{{ section.id }} .ul-hero .ul-wrap, #ul-{{ section.id }} .ul-compra .ul-wrap { grid-template-columns: 1fr; gap: 32px; }
    #ul-{{ section.id }} .ul-escena { order: -1; max-width: 420px; width: 100%; margin: 0 auto; }
    #ul-{{ section.id }} .ul-galeria { position: static; }
    #ul-{{ section.id }} .ul-compra { padding: 56px 0; }
    #ul-{{ section.id }} .ul-pasos ol { grid-template-columns: 1fr; gap: 24px; }
    #ul-{{ section.id }} .ul-barra { display: flex; }
    #ul-{{ section.id }} .ul-faq { padding-bottom: 120px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #ul-{{ section.id }} *, #ul-{{ section.id }} *::before, #ul-{{ section.id }} *::after { animation: none !important; transition: none !important; }
    #ul-{{ section.id }} .ul-ruta .ul-trazo { stroke-dashoffset: 0; }
    #ul-{{ section.id }} .ul-punto { opacity: 1; }
  }
</style>

<div id="ul-{{ section.id }}">
  <section class="ul-hero">
    <div class="ul-wrap">
      <div>
        <h1>{{ section.settings.titulo }}</h1>
        <p class="ul-sub">{{ section.settings.subtitulo }}</p>
        <dl class="ul-specs">
          <div><dt>2,2 g</dt><dd>Peso</dd></div>
          <div><dt>30 días</dt><dd>De batería</dd></div>
          <div><dt>IP68</dt><dd>Agua y polvo</dd></div>
        </dl>
        <div class="ul-accion">
          <a class="ul-btn" href="#ul-comprar">Elegir pack</a>
          <p class="ul-desde">Desde <strong>{{ unidad3 | money }}</strong> por unidad</p>
        </div>
        <ul class="ul-confianza">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Envío gratis a España, Francia y Alemania</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>14 días para devolverlo</li>
        </ul>
      </div>
      <div class="ul-escena">
        {%- assign imgHero = p.images | where: 'alt', 'MiniRastreador colocado en la pata de una paloma' | first -%}
        {%- if imgHero == blank -%}{%- assign imgHero = p.featured_image -%}{%- endif -%}
        {%- if imgHero -%}
          {{ imgHero | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: imgHero.alt, sizes: '(max-width: 860px) 90vw, 480px' }}
        {%- endif -%}
        <svg class="ul-ruta" viewBox="0 0 400 400" aria-hidden="true">
          <defs><mask id="ul-mascara-{{ section.id }}"><path class="ul-trazo" d="M52 340 C 90 250, 150 330, 205 240 S 300 120, 336 70"/></mask></defs>
          <path class="ul-linea" mask="url(#ul-mascara-{{ section.id }})" d="M52 340 C 90 250, 150 330, 205 240 S 300 120, 336 70"/>
          <g class="ul-palomar"><path d="M38 352 l14 -12 l14 12 v14 h-28z"/></g>
          <circle class="ul-onda" cx="336" cy="70" r="9"/>
          <circle class="ul-punto" cx="336" cy="70" r="9"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="ul-compra" id="ul-comprar">
    <div class="ul-wrap">
      <div class="ul-galeria">
        <div class="ul-principal">
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: p.title, class: 'ul-img-principal', sizes: '(max-width: 860px) 92vw, 520px' }}
          {%- endif -%}
        </div>
        {%- if p.images.size > 1 -%}
          <div class="ul-thumbs">
            {%- for img in p.images -%}
              <button type="button" class="ul-thumb" data-src="{{ img | image_url: width: 1100 }}" aria-label="Ver imagen {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}>
                {{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div>
        <h2>{{ p.title }}</h2>
        <p class="ul-sub">Elige cuántos necesitas. El descuento del pack se aplica solo al pagar.</p>
        <fieldset class="ul-packs">
          <legend class="visually-hidden">Cantidad</legend>
          <label class="ul-pack">
            <input type="radio" name="ul-pack-{{ section.id }}" value="1" data-total="{{ precio1 | money }}">
            <span class="ul-radio"></span>
            <span><span class="ul-pack-nombre">1 unidad</span></span>
            <span class="ul-pack-precio">{{ precio1 | money }}</span>
          </label>
          <label class="ul-pack">
            <span class="ul-etiqueta">Recomendado</span>
            <input type="radio" name="ul-pack-{{ section.id }}" value="2" data-total="{{ precio2 | money }}" checked>
            <span class="ul-radio"></span>
            <span>
              <span class="ul-pack-nombre">2 unidades</span>
              <span class="ul-pack-detalle">{{ unidad2 | money }} cada uno, <span class="ul-ahorro">ahorras {{ ahorro2 | money }}</span></span>
            </span>
            <span class="ul-pack-precio"><s>{{ v.price | times: 2 | money }}</s>{{ precio2 | money }}</span>
          </label>
          <label class="ul-pack">
            <input type="radio" name="ul-pack-{{ section.id }}" value="3" data-total="{{ precio3 | money }}">
            <span class="ul-radio"></span>
            <span>
              <span class="ul-pack-nombre">3 unidades</span>
              <span class="ul-pack-detalle">{{ unidad3 | money }} cada uno, <span class="ul-ahorro">ahorras {{ ahorro3 | money }}</span></span>
            </span>
            <span class="ul-pack-precio"><s>{{ v.price | times: 3 | money }}</s>{{ precio3 | money }}</span>
          </label>
        </fieldset>
        {%- if v.available -%}
          <a class="ul-btn ul-comprar" href="{{ routes.cart_url }}" data-base="{{ urlCompra }}" data-destino="{% if section.settings.destino == 'pago' %}/checkout{% else %}{{ routes.cart_url }}{% endif %}">Comprar por {{ precio2 | money }}</a>
        {%- else -%}
          <span class="ul-btn ul-comprar" aria-disabled="true">Agotado temporalmente</span>
        {%- endif -%}
        <p class="ul-nota">Entrega estimada en 7 a 15 días laborables, con número de seguimiento.</p>
        <ul class="ul-garantias">
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span><strong>Pago seguro</strong>Datos cifrados, nunca vemos tu tarjeta</span></li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg><span><strong>14 días de devolución</strong>Sin dar explicaciones</span></li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span><strong>Garantía de 3 años</strong>Si falla, lo cambiamos</span></li>
          <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg><span><strong>Te ayudamos</strong>Atención por email en español</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="ul-pasos">
    <div class="ul-wrap">
      <h2>Cómo funciona</h2>
      <ol>
        <li><h3>Colócalo</h3><p>Ajusta el anillo en la pata trasera del ave.</p></li>
        <li><h3>Vincúlalo</h3><p>Descarga la aplicación y empareja el rastreador.</p></li>
        <li><h3>Consúltalo</h3><p>Mira su ubicación desde el móvil cuando quieras.</p></li>
      </ol>
    </div>
  </section>

  <section class="ul-faq">
    <div class="ul-wrap">
      <h2>Preguntas frecuentes</h2>
      <details><summary>¿Cuánto tarda en llegar?</summary><p>Entre 7 y 15 días laborables. Te enviamos el número de seguimiento por email en cuanto sale.</p></details>
      <details><summary>¿Cuánto cuesta el envío?</summary><p>Es gratis a España, Francia y Alemania. Al resto de la Unión Europea cuesta 8,99 €.</p></details>
      <details><summary>¿Le molesta al ave?</summary><p>Pesa 2,2 gramos y va en la pata trasera, así que no interfiere con el vuelo.</p></details>
      <details><summary>¿Y si no me convence?</summary><p>Tienes 14 días desde que lo recibes para devolverlo. {% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Ver política de devoluciones</a>{% endif %}</p></details>
    </div>
  </section>

  <div class="ul-barra" aria-hidden="true">
    <p><strong>{{ p.title }}</strong>Desde {{ unidad3 | money }} por unidad</p>
    <a class="ul-btn" href="#ul-comprar" tabindex="-1">Comprar</a>
  </div>
</div>

<script>
  (function () {
    const raiz = document.getElementById('ul-{{ section.id }}');
    if (!raiz) return;
    const btnCompra = raiz.querySelector('.ul-comprar[data-base]');
    raiz.querySelectorAll('.ul-packs input').forEach(function (inp) {
      inp.addEventListener('change', function () {
        if (!btnCompra) return;
        btnCompra.textContent = 'Comprar por ' + inp.dataset.total;
      });
    });
    if (btnCompra) {
      btnCompra.addEventListener('click', function (ev) {
        ev.preventDefault();
        if (btnCompra.dataset.ocupado) return;
        btnCompra.dataset.ocupado = '1';
        const sel = raiz.querySelector('.ul-packs input:checked');
        const cant = sel ? parseInt(sel.value, 10) : 1;
        const cab = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
        btnCompra.style.opacity = '0.7';
        fetch('{{ routes.cart_clear_url }}.js', { method: 'POST', headers: cab })
          .then(function () {
            return fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: cab, body: JSON.stringify({ items: [{ id: {{ v.id }}, quantity: cant }] }) });
          })
          .then(function (r) {
            if (!r.ok) throw new Error('add');
            window.location.href = btnCompra.dataset.destino;
          })
          .catch(function () {
            delete btnCompra.dataset.ocupado;
            btnCompra.style.opacity = '';
            window.location.href = '{{ routes.cart_url }}';
          });
      });
    }
    const principal = raiz.querySelector('.ul-img-principal');
    raiz.querySelectorAll('.ul-thumb').forEach(function (t) {
      t.addEventListener('click', function () {
        if (!principal) return;
        raiz.querySelectorAll('.ul-thumb').forEach(function (o) { o.removeAttribute('aria-current'); });
        t.setAttribute('aria-current', 'true');
        principal.removeAttribute('srcset');
        principal.style.opacity = '0';
        setTimeout(function () { principal.src = t.dataset.src; principal.style.opacity = '1'; }, 150);
      });
    });
    const barra = raiz.querySelector('.ul-barra');
    const hero = raiz.querySelector('.ul-hero');
    const compra = raiz.querySelector('.ul-compra');
    if (barra && 'IntersectionObserver' in window) {
      const vis = new Map();
      const obs = new IntersectionObserver(function (ents) {
        ents.forEach(function (e) { vis.set(e.target, e.isIntersecting); });
        barra.classList.toggle('ul-visible', !vis.get(hero) && !vis.get(compra));
      });
      obs.observe(hero);
      obs.observe(compra);
    }
  })();
</script>

{% schema %}
{
  "name": "UtilsLA portada",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Localiza a tu ave desde el móvil" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Un anillo que se coloca en la pata trasera y se consulta desde la aplicación." },
    { "type": "number", "id": "descuento2", "label": "Descuento pack 2 (%)", "default": 10 },
    { "type": "number", "id": "descuento3", "label": "Descuento pack 3 (%)", "default": 15 },
    { "type": "select", "id": "destino", "label": "Al comprar, ir a", "options": [{ "value": "carrito", "label": "Carrito" }, { "value": "pago", "label": "Pago directo" }], "default": "carrito" }
  ],
  "presets": [{ "name": "UtilsLA portada" }]
}
{% endschema %}
