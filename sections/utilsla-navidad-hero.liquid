{%- render 'utilsla-navidad-recursos', con_js: true -%}

{%- liquid
  assign cinta = section.settings.cinta
  assign id_brillo = 'uh-brillo-' | append: section.id
  assign vitrina = blank
  if section.settings.mostrar_productos
    assign elegidos = ''
    if section.settings.producto_1 != blank
      assign elegidos = section.settings.producto_1.handle
    endif
    if section.settings.producto_2 != blank
      assign elegidos = elegidos | append: ',' | append: section.settings.producto_2.handle
    endif
    assign elegidos = elegidos | remove_first: ',' | split: ','
    if elegidos.size > 0
      assign vitrina = elegidos
    else
      assign col_vitrina = collections['navidad']
      if col_vitrina != blank and col_vitrina.products_count > 0
        assign asas = ''
        for prod_col in col_vitrina.products limit: 2
          assign asas = asas | append: prod_col.handle | append: ','
        endfor
        assign vitrina = asas | split: ','
      endif
    endif
  endif
-%}

<section
  class="uh uh-hero{% if vitrina != blank %} uh-hero--vitrina{% endif %}"
  data-uh="hero"
  aria-labelledby="uh-hero-titulo-{{ section.id }}"
>
  <div class="uh-hero__fondo" aria-hidden="true">
    <div class="uh-hero__cielo"></div>
    {%- if section.settings.particulas -%}
      <canvas class="uh-particulas" data-uh-particulas data-densidad="1"></canvas>
    {%- endif -%}

    <div class="uh-luna" data-uh-capa="luna" data-uh-mueve="-26">
      <span class="uh-luna__disco"></span>
    </div>


    <div class="uh-niebla uh-niebla--lejos" data-uh-capa="niebla-lejos" data-uh-mueve="18">
      <span class="uh-niebla__vel"></span>
    </div>

    <svg class="uh-paisaje" data-uh-capa="paisaje" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice" focusable="false">
      <defs>
        <radialGradient id="{{ id_brillo }}" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#f2b33d" stop-opacity=".55" />
          <stop offset="1" stop-color="#f2b33d" stop-opacity="0" />
        </radialGradient>
      </defs>
      <path fill="#163d2c" d="M0 360V250C120 220 220 240 340 215C470 190 560 235 700 225C860 212 960 170 1100 195C1230 218 1340 205 1440 190V360Z" />
      <path fill="#d9e4ee" opacity=".16" d="M0 252C120 222 220 242 340 217C470 192 560 237 700 227C860 214 960 172 1100 197C1230 220 1340 207 1440 192V200C1340 215 1230 228 1100 205C960 180 860 222 700 235C560 245 470 200 340 225C220 250 120 230 0 260Z" />
      <path fill="#0e2a1f" d="M0 360V285C160 262 300 292 470 276C640 260 760 296 940 280C1100 266 1260 290 1440 270V360Z" />
      <g fill="#0a0f0d">
        <path d="M0 360V312C140 296 260 318 420 306C600 292 700 326 900 312C1060 300 1220 322 1440 304V360Z" />
        <rect x="640" y="222" width="130" height="104" />
        <path d="M624 226 705 156 786 226z" />
        <rect x="752" y="150" width="22" height="50" />
        <path d="M300 172 268 236H284L256 286H276L244 322H356L324 286H344L316 236H332Z" />
        <path d="M1180 196 1156 244H1168L1146 284H1162L1138 314H1222L1198 284H1214L1192 244H1204Z" />
        <path d="M1262 216 1244 252H1254L1236 284H1248L1230 308H1294L1276 284H1288L1270 252H1280Z" />
      </g>
      <g fill="#e9eff5">
        <path opacity=".92" d="M0 312C140 296 260 318 420 306C600 292 700 326 900 312C1060 300 1220 322 1440 304V312C1220 330 1060 308 900 320C700 334 600 300 420 314C260 326 140 304 0 320Z" />
        <path opacity=".85" d="M624 226 705 156 786 226 778 226 705 166 632 226Z" />
        <rect opacity=".85" x="750" y="146" width="26" height="6" rx="3" />
      </g>
      <g class="uh-ventanas" fill="#ffcf6b">
        <rect class="uh-ventana" x="662" y="246" width="16" height="22" rx="2" />
        <rect class="uh-ventana uh-ventana--2" x="718" y="246" width="16" height="22" rx="2" />
        <rect class="uh-ventana uh-ventana--3" x="698" y="196" width="14" height="16" rx="2" />
      </g>
      <circle cx="900" cy="270" r="78" fill="url(#{{ id_brillo }})" />
      <path fill="#0f3b2a" d="M900 212 872 256H884L862 290H876L850 320H950L924 290H938L916 256H928Z" />
      <path fill="#f2b33d" d="M900 196l3.5 7.5 8 1-6 5.5 1.6 8-7.1-4-7.1 4 1.6-8-6-5.5 8-1z" />
      <g class="uh-ventanas">
        <circle class="uh-ventana" cx="892" cy="240" r="3" fill="#ffd27a" />
        <circle class="uh-ventana uh-ventana--2" cx="908" cy="252" r="3" fill="#e8414f" />
        <circle class="uh-ventana uh-ventana--3" cx="884" cy="272" r="3" fill="#ffffff" />
        <circle class="uh-ventana" cx="914" cy="280" r="3" fill="#ffd27a" />
        <circle class="uh-ventana uh-ventana--2" cx="876" cy="304" r="3" fill="#e8414f" />
        <circle class="uh-ventana uh-ventana--3" cx="900" cy="298" r="3" fill="#ffffff" />
        <circle class="uh-ventana" cx="926" cy="308" r="3" fill="#ffd27a" />
      </g>
    </svg>

    <div class="uh-niebla uh-niebla--cerca" data-uh-capa="niebla-cerca" data-uh-mueve="-34">
      <span class="uh-niebla__vel uh-niebla__vel--inversa"></span>
    </div>
  </div>

  <div class="uh-contenedor uh-hero__contenido" data-uh-contenido>
    {%- if section.settings.eyebrow != blank -%}
      <p class="uh-eyebrow" data-uh-entrada>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="uh-hero__titulo" id="uh-hero-titulo-{{ section.id }}" data-uh-titulo>{{ section.settings.titulo }}</h1>
    {%- if section.settings.subtitulo != blank -%}
      <p class="uh-hero__sub" data-uh-entrada>{{ section.settings.subtitulo }}</p>
    {%- endif -%}
    <div class="uh-hero__accion" data-uh-entrada>
      <a class="uh-btn uh-btn--principal" href="#coleccion" data-uh-ancla>
        <span class="uh-btn__texto">{{ section.settings.boton | default: 'Ver la colección' }}</span>
        <svg class="uh-btn__flecha" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 3v13M5 11.500l5 5 5-5" /></svg>
      </a>
    </div>

    {%- if vitrina != blank -%}
      <ul class="uh-vitrina" aria-label="Productos de Navidad">
        {%- for asa in vitrina -%}
          {%- assign prod = all_products[asa] -%}
          {%- if prod == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign carga = 'lazy'
            assign prioridad = 'auto'
            if forloop.first
              assign carga = 'eager'
              assign prioridad = 'high'
            endif
          -%}
          <li class="uh-vitrina__item uh-vitrina__item--{{ forloop.index }}">
            <a class="uh-vitrina__enlace" href="{{ prod.url }}">
              <span class="uh-vitrina__marco">
                {%- if prod.featured_media != blank -%}
                {{
                  prod.featured_media
                  | image_url: width: 900
                  | image_tag:
                    widths: '240, 360, 480, 640, 900',
                    sizes: '(min-width: 990px) 260px, 42vw',
                    loading: carga,
                    fetchpriority: prioridad,
                    decoding: 'async',
                    class: 'uh-vitrina__img',
                    alt: prod.featured_media.alt | default: prod.title
                  }}
                {%- else -%}
                  {%- render 'utilsla-navidad-ilustracion', producto: prod, sufijo: 'vitrina', clase: 'uh-vitrina__img', nota: false -%}
                {%- endif -%}
                <svg class="uh-vitrina__telarana" viewBox="0 0 60 60" aria-hidden="true" focusable="false"><path d="M8 0v10M3 5h10M4.5 1.5l7 7M11.5 1.5l-7 7M30 0q6 10 12 0M42 0q6 10 12 0M20 0q5 12 10 0" /></svg>
              </span>
              <span class="uh-vitrina__pie">
                <span class="uh-vitrina__nombre">{{ prod.title | split: '(' | first | strip | escape }}</span>
                <span class="uh-vitrina__precio">{{ prod.price | money }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if cinta != blank -%}
    <div class="uh-cinta" aria-hidden="true">
      <div class="uh-cinta__pista">
        {%- for i in (1..2) -%}
          <div class="uh-cinta__grupo">
            {%- for j in (1..3) -%}
              <span>{{ cinta }}</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Navidad hero",
  "tag": "div",
  "class": "uh-seccion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "UtilsLA · Luces y decoración de Navidad" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "info": "Usa cursiva para la palabra destacada.", "default": "Luces de <em>Navidad</em> para tu casa" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Luz cálida para el salón, la ventana y el balcón. Precios finales con IVA y 14 días para devolverlo." },
    { "type": "text", "id": "boton", "label": "Texto del botón", "info": "Baja hasta la rejilla de productos.", "default": "Ver la colección" },
    { "type": "text", "id": "cinta", "label": "Cinta en movimiento", "info": "Déjalo vacío para ocultar la cinta.", "default": "Colección de Navidad ✦ Envío gratis a España, Francia y Alemania ✦" },
    { "type": "checkbox", "id": "particulas", "label": "Partículas flotantes", "default": true },
    { "type": "header", "content": "Fotos de producto" },
    { "type": "checkbox", "id": "mostrar_productos", "label": "Mostrar los productos en el primer pantallazo", "default": true },
    { "type": "product", "id": "producto_1", "label": "Producto 1", "info": "Si no eliges ninguno se usan los 2 primeros de la colección navidad." },
    { "type": "product", "id": "producto_2", "label": "Producto 2" }
  ],
  "presets": [{ "name": "Navidad hero" }]
}
{% endschema %}
