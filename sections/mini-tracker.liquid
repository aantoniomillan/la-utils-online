{% comment %}
  MiniRastreador - Landing moderna con animaciones
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

  :root {
    --bg: #0B0D10;
    --bg-soft: #14181F;
    --card: #1A1F28;
    --text: #F4F6F8;
    --muted: #9AA3B2;
    --accent: #3DDC97;
    --border: rgba(255,255,255,0.08);
    --radius: 16px;
    --max: 1140px;
  }

  .mr * { box-sizing: border-box; }
  .mr {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .mr h1, .mr h2, .mr h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .mr a { color: inherit; text-decoration: none; }
  .mr img { max-width: 100%; display: block; }
  .mr .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(61,220,151,0.35); }
    50% { box-shadow: 0 0 0 14px rgba(61,220,151,0); }
  }
  .mr .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .mr .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .mr-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11,13,16,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .mr-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }
  .mr-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
  }
  .mr-logo-dot {
    width: 10px;
    height: 10px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-glow 2.4s infinite;
  }
  .mr-nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mr-nav-links a {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.2s;
  }
  .mr-nav-links a:hover { color: var(--text); }
  .mr-cta-nav {
    background: var(--accent);
    color: #0B0D10;
    padding: 9px 18px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .mr-cta-nav:hover { background: #4af0a8; }
  @media (max-width: 780px) {
    .mr-nav-links { display: none; }
  }

  .mr-hero { padding: 80px 0 100px; }
  .mr-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .mr-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .mr-hero-visual { order: -1; }
  }
  .mr-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(61,220,151,0.12);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .mr-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.1;
    max-width: 14ch;
  }
  .mr-hero h1 span { color: var(--accent); }
  .mr-hero-sub {
    margin-top: 18px;
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 42ch;
  }
  .mr-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .mr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.2s, background 0.2s;
  }
  .mr-btn-primary {
    background: var(--accent);
    color: #0B0D10;
  }
  .mr-btn-primary:hover { transform: translateY(-2px); background: #4af0a8; }
  .mr-btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
  }
  .mr-btn-ghost:hover { border-color: rgba(255,255,255,0.25); }
  .mr-hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .mr-hero-stats div { font-size: 0.85rem; color: var(--muted); }
  .mr-hero-stats strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem;
    color: var(--text);
    font-weight: 600;
  }

  .mr-hero-visual { display: flex; justify-content: center; }
  .mr-product-card {
    position: relative;
    background: linear-gradient(160deg, #1c2330 0%, #12161e 100%);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 20px;
    max-width: 380px;
    width: 100%;
    animation: float 5s ease-in-out infinite;
  }
  .mr-product-card img { width: 100%; border-radius: 14px; }
  .mr-product-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 50% 40%, rgba(61,220,151,0.18), transparent 60%);
    pointer-events: none;
    z-index: -1;
  }

  .mr-section { padding: 90px 0; }
  .mr-section-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 48px;
  }
  .mr-section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); }
  .mr-section-head p { margin-top: 12px; color: var(--muted); }

  .mr-cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  @media (max-width: 860px) { .mr-cases { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .mr-cases { grid-template-columns: 1fr; } }
  .mr-case {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px 22px;
    transition: transform 0.25s, border-color 0.25s;
  }
  .mr-case:hover {
    transform: translateY(-4px);
    border-color: rgba(61,220,151,0.35);
  }
  .mr-case-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(61,220,151,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .mr-case h3 { font-size: 1.1rem; margin-bottom: 6px; }
  .mr-case p { font-size: 0.9rem; color: var(--muted); margin: 0; }

  .mr-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    counter-reset: step;
  }
  @media (max-width: 760px) { .mr-steps { grid-template-columns: 1fr; } }
  .mr-step {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px 24px;
  }
  .mr-step::before {
    counter-increment: step;
    content: "0" counter(step);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    display: block;
    margin-bottom: 14px;
  }
  .mr-step h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .mr-step p { color: var(--muted); margin: 0; font-size: 0.95rem; }

  .mr-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (max-width: 800px) { .mr-specs-grid { grid-template-columns: 1fr; } }
  .mr-spec-row {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .mr-spec-row span:first-child { color: var(--muted); }
  .mr-spec-row span:last-child {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
  }
  .mr-specs-visual {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 16px;
  }
  .mr-specs-visual img { width: 100%; border-radius: 12px; }

  .mr-app {
    background: var(--bg-soft);
    border-radius: 24px;
    padding: 48px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    border: 1px solid var(--border);
  }
  @media (max-width: 800px) {
    .mr-app { grid-template-columns: 1fr; padding: 32px 24px; }
  }
  .mr-app h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 12px; }
  .mr-app p { color: var(--muted); margin-bottom: 24px; }
  .mr-app-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .mr-app-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
  }
  .mr-app-features li::before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .mr-phone {
    background: #0d1118;
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: 12px;
    max-width: 280px;
    margin: 0 auto;
  }
  .mr-phone-screen {
    background: #121820;
    border-radius: 20px;
    padding: 18px 14px;
    min-height: 380px;
  }
  .mr-phone-map {
    height: 180px;
    background: linear-gradient(160deg, #1a2433, #0f1520);
    border-radius: 12px;
    position: relative;
    margin-bottom: 16px;
  }
  .mr-phone-pin {
    position: absolute;
    top: 42%;
    left: 55%;
    width: 14px;
    height: 14px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 0 8px rgba(61,220,151,0.25);
    animation: pulse-glow 2s infinite;
  }
  .mr-phone-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .mr-phone-row strong { color: var(--text); }

  .mr-final {
    text-align: center;
    padding: 100px 0 110px;
  }
  .mr-final h2 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin-bottom: 14px;
  }
  .mr-final p { color: var(--muted); margin-bottom: 10px; }
  .mr-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.2rem;
    font-weight: 600;
    margin: 18px 0 28px;
  }
  .mr-price span {
    font-size: 1rem;
    font-weight: 400;
    color: var(--muted);
    font-family: 'Inter', sans-serif;
  }

  .mr-footer {
    border-top: 1px solid var(--border);
    padding: 28px 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .mr-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .mr-footer nav { display: flex; gap: 20px; }
  .mr-footer a:hover { color: var(--text); }
</style>

