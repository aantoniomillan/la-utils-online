{%- comment -%}
  UtilsLA · Ficha del proyector con el estilo de la portada.
  Usa los packs reales (variantes) del snippet utilsla-packs y el mismo JS de carrito.
{%- endcomment -%}
{%- liquid
  assign p = product
  assign f_tit = section.settings.fuente_titulos
  assign f_tit_it = f_tit | font_modify: 'style', 'italic'
  assign f_txt = section.settings.fuente_texto
  assign f_txt_med = f_txt | font_modify: 'weight', '500'
  assign base_assets = 'utilsla-cine.css' | asset_url | split: 'utilsla-cine.css' | first

  assign v_uno = p.variants | first
  assign min_unidad = v_uno.price
  for var in p.variants
    assign uds = var.title | split: ' ' | first | times: 1
    if uds < 1
      assign uds = 1
    endif
    assign por_unidad = var.price | times: 1.0 | divided_by: uds | round
    if por_unidad < min_unidad
      assign min_unidad = por_unidad
    endif
  endfor
-%}

<style>
  {{ f_tit | font_face: font_display: 'swap' }}
  {{ f_tit_it | font_face: font_display: 'swap' }}
  {{ f_txt | font_face: font_display: 'swap' }}
  {{ f_txt_med | font_face: font_display: 'swap' }}
  #uc-{{ section.id }} {
    --uc-f-tit: {{ f_tit.family }}, {{ f_tit.fallback_families }};
    --uc-f-txt: {{ f_txt.family }}, {{ f_txt.fallback_families }};
  }
</style>
{{ 'utilsla-cine.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
<script src="{{ 'SplitText.min.js' | asset_url }}" defer></script>
<script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
<script src="{{ 'utilsla-cine.js' | asset_url }}" defer></script>

<div
  id="uc-{{ section.id }}"
  class="uc ucx-producto"
  data-uc
  data-assets="{{ base_assets }}"
  data-carrito="{{ routes.cart_url }}"
  data-carrito-add="{{ routes.cart_add_url }}"
  {% if request.design_mode %}data-editor{% endif %}
>
  <div class="uc-progreso" aria-hidden="true"><span data-uc-progreso></span></div>

  <div class="uc-contenedor ucx-producto__rejilla">
    <div class="ucx-galeria">
      {%- if p.media.size > 0 -%}
        <ul class="ucx-galeria__lista" aria-label="Imágenes del producto">
          {%- for medio in p.media -%}
            <li class="ucx-galeria__item">
              {%- case medio.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign carga = 'lazy'
                    if forloop.first
                      assign carga = 'eager'
                    endif
                  -%}
                  {{
                    medio
                    | image_url: width: 1600
                    | image_tag:
                      widths: '600, 900, 1200, 1600',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      loading: carga,
                      alt: medio.alt | default: p.title
                  }}
                {%- when 'video' -%}
                  {{ medio | video_tag: autoplay: false, controls: true, muted: true, playsinline: true, preload: 'metadata', image_size: '1600x' }}
                {%- when 'external_video' -%}
                  {{ medio | external_video_tag }}
                {%- else -%}
                  {{ medio | media_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="ucx-galeria__escena" aria-hidden="true">
          <span class="uc-final__copos"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
          <div class="ucx-galeria__haz"></div>
          <svg class="ucx-galeria__proyector" data-uc-proyector-svg viewBox="0 0 200 172">
            <defs>
              <linearGradient id="ucx-cuerpo-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#34425F" /><stop offset=".55" stop-color="#1B2640" /><stop offset="1" stop-color="#0B1120" />
              </linearGradient>
              <radialGradient id="ucx-lente-{{ section.id }}" cx=".42" cy=".38" r=".7">
                <stop offset="0" stop-color="#FFF6E6" /><stop offset=".35" stop-color="#FFC778" /><stop offset=".78" stop-color="#6D4214" /><stop offset="1" stop-color="#140D05" />
              </radialGradient>
            </defs>
            <ellipse cx="100" cy="162" rx="64" ry="7" fill="#000" opacity=".4" />
            <path d="M72 148h56l-7 12H79z" fill="#121A2B" />
            <rect x="48" y="60" width="104" height="94" rx="42" fill="url(#ucx-cuerpo-{{ section.id }})" />
            <ellipse cx="100" cy="64" rx="41" ry="16" fill="#0A0F1C" stroke="#3A4866" stroke-width="2" />
            <ellipse cx="100" cy="62" rx="30" ry="11" fill="url(#ucx-lente-{{ section.id }})" />
          </svg>
        </div>
      {%- endif -%}
    </div>

    <div class="ucx-producto__info">
      <p class="uc-eyebrow uc-eyebrow--oscuro">{{ p.vendor | default: shop.name }}</p>
      <h1 class="uc-h2 ucx-producto__titulo" data-uc-lineas>{{ p.title }}</h1>
      <p class="ucx-producto__desde">Desde <strong>{{ min_unidad | money }}</strong> la unidad</p>

      {%- if p.variants.size > 0 -%}
        {%- render 'utilsla-packs', producto: p, recomendado: section.settings.pack_recomendado -%}
      {%- endif -%}

      <ul class="uc-confianza">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>
          Envío gratis a España, Francia y Alemania
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
          14 días de devolución
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
          Pago seguro
        </li>
      </ul>

      {%- if p.description != blank -%}
        <div class="ucx-producto__descripcion">
          <p class="uc-eyebrow uc-eyebrow--oscuro">Descripción</p>
          <div class="ucx-rte">{{ p.description }}</div>
        </div>
      {%- endif -%}

      <ol class="ucx-producto__pasos">
        <li><span>1</span>Enchúfalo a cualquier cargador USB.</li>
        <li><span>2</span>Oriéntalo hacia la pared, la fachada o el techo.</li>
        <li><span>3</span>En un minuto, la Navidad encendida.</li>
      </ol>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ p | structured_data }}
</script>

{% schema %}
{
  "name": "UtilsLA producto",
  "tag": "section",
  "class": "ucx-producto-seccion",
  "settings": [
    { "type": "number", "id": "pack_recomendado", "label": "Pack recomendado (posición de la variante)", "default": 2 },
    { "type": "font_picker", "id": "fuente_titulos", "label": "Titulares", "default": "bodoni_moda_n4" },
    { "type": "font_picker", "id": "fuente_texto", "label": "Texto", "default": "instrument_sans_n4" }
  ]
}
{% endschema %}
