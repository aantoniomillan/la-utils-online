{%- comment -%}
  UtilsLA · Carrito con el estilo de Halloween.
  Funciona sin JS (botón «Actualizar»); con JS, cambiar la cantidad envía el formulario.
  Debajo sugiere los productos de la colección Halloween que aún no están en el carrito.
{%- endcomment -%}
{%- render 'utilsla-halloween-recursos', con_js: false -%}

{%- liquid
  assign col = section.settings.coleccion
  if col == blank
    assign col = collections['halloween']
  endif
  assign ids_carrito = cart.items | map: 'product_id' | join: ','
  assign ids_carrito = ',' | append: ids_carrito | append: ','
  assign envio = section.settings.envio | strip
  assign plazo = section.settings.plazo | strip
-%}

<section class="uh uh-carrito" id="uh-carrito-{{ section.id }}" aria-labelledby="uh-carrito-titulo-{{ section.id }}">
  <div class="uh-contenedor">
    <p class="uh-eyebrow">Carrito</p>
    <h1 class="uh-titulo uh-carrito__titulo" id="uh-carrito-titulo-{{ section.id }}">
      {%- if cart.item_count > 0 -%}Tu pedido de <em>Halloween</em>{%- else -%}Tu carrito está <em>vacío</em>{%- endif -%}
    </h1>

    {%- if cart.item_count > 0 -%}
      <form class="uh-carrito__rejilla" action="{{ routes.cart_url }}" method="post" novalidate data-uh-carrito-form>
        <ul class="uh-carrito__lineas" aria-label="Productos del carrito">
          {%- for item in cart.items -%}
            <li class="uh-linea">
              <a class="uh-linea__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: widths: '150, 225, 300', sizes: '(min-width: 750px) 120px, 92px', alt: '', loading: 'lazy', decoding: 'async' }}
                {%- else -%}
                  {%- render 'utilsla-halloween-ilustracion', producto: item.product, sufijo: 'linea', clase: '', nota: false -%}
                {%- endif -%}
              </a>
              <div class="uh-linea__info">
                <a class="uh-linea__nombre" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="uh-linea__variante">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <p class="uh-linea__unidad">{{ item.final_price | money }} / unidad</p>
                {%- for descuento in item.line_level_discount_allocations -%}
                  <p class="uh-linea__descuento">{{ descuento.discount_application.title | escape }} (−{{ descuento.amount | money }})</p>
                {%- endfor -%}
                <div class="uh-linea__controles">
                  <label class="uh-oculto" for="uh-cant-{{ item.key }}">Cantidad de {{ item.product.title | escape }}</label>
                  <div class="uh-cantidad">
                    <button type="button" class="uh-cantidad__btn" data-uh-menos aria-label="Quitar una unidad de {{ item.product.title | escape }}">−</button>
                    <input
                      class="uh-cantidad__input"
                      id="uh-cant-{{ item.key }}"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      inputmode="numeric"
                    >
                    <button type="button" class="uh-cantidad__btn" data-uh-mas aria-label="Añadir una unidad de {{ item.product.title | escape }}">+</button>
                  </div>
                  <a class="uh-linea__quitar" href="{{ item.url_to_remove }}">Quitar</a>
                </div>
              </div>
              <div class="uh-linea__precio">
                {%- if item.original_line_price > item.final_line_price -%}
                  <s>{{ item.original_line_price | money }}</s>
                {%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <aside class="uh-resumen" aria-label="Resumen del pedido">
          <p class="uh-resumen__fila"><span>Productos ({{ cart.item_count }})</span><span>{{ cart.items_subtotal_price | money }}</span></p>
          {%- for descuento in cart.cart_level_discount_applications -%}
            <p class="uh-resumen__fila"><span>{{ descuento.title | escape }}</span><span>−{{ descuento.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="uh-resumen__fila uh-resumen__total">
            <span>Total</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </p>
          <p class="uh-resumen__nota">
            {%- if cart.taxes_included -%}IVA incluido.{%- else -%}Impuestos calculados al pagar.{%- endif %}
            Los gastos de envío y los códigos de descuento se aplican en la página de pago.
          </p>
          <noscript><button type="submit" class="uh-btn uh-btn--contorno uh-btn--bloque">Actualizar carrito</button></noscript>
          <button type="submit" name="checkout" class="uh-btn uh-btn--calabaza uh-resumen__pagar">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><rect x="4" y="11" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            Pagar de forma segura
          </button>
          {%- if additional_checkout_buttons -%}
            <div class="uh-resumen__rapido">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
          <ul class="uh-resumen__confianza">
            {%- if envio != blank -%}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>
                {{ envio | escape }}
              </li>
            {%- endif -%}
            {%- if plazo != blank -%}
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                {{ plazo | escape }}
              </li>
            {%- endif -%}
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
              14 días para devolverlo
            </li>
          </ul>
          <a class="uh-resumen__seguir" href="{{ col.url | default: routes.all_products_collection_url }}">Seguir comprando</a>
        </aside>
      </form>
    {%- else -%}
      <p class="uh-carrito__vacio">Elige tu decoración y la recibes antes de la noche de Halloween.</p>
      <a class="uh-btn uh-btn--calabaza" href="{{ col.url | default: routes.all_products_collection_url }}">
        Ver la colección Halloween <span class="uh-btn__flecha" aria-hidden="true">→</span>
      </a>
    {%- endif -%}

    {%- if col != blank and col.products_count > 0 -%}
      {%- capture sugerencias -%}
        {%- for prod in col.products limit: 6 -%}
          {%- assign marca = ',' | append: prod.id | append: ',' -%}
          {%- if ids_carrito contains marca or prod.available == false -%}{%- continue -%}{%- endif -%}
          {%- assign v = prod.selected_or_first_available_variant -%}
          <li class="uh-sugerencia">
            <a class="uh-sugerencia__img" href="{{ prod.url }}" tabindex="-1" aria-hidden="true">
              {%- if prod.featured_image -%}
                {{ prod.featured_image | image_url: width: 360 | image_tag: widths: '180, 270, 360', sizes: '(min-width: 750px) 160px, 112px', alt: '', loading: 'lazy', decoding: 'async' }}
              {%- else -%}
                {%- render 'utilsla-halloween-ilustracion', producto: prod, sufijo: 'sugerencia', clase: '', nota: false -%}
              {%- endif -%}
            </a>
            <div class="uh-sugerencia__info">
              <a class="uh-sugerencia__nombre" href="{{ prod.url }}">{{ prod.title | escape }}</a>
              <p class="uh-sugerencia__precio">
                {{ v.price | money }}
                {%- if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{%- endif -%}
              </p>
              <form action="{{ routes.cart_add_url }}" method="post">
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="uh-btn uh-btn--contorno uh-sugerencia__btn">Añadir</button>
              </form>
            </div>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if sugerencias != blank -%}
        <div class="uh-carrito__sugerencias">
          <h2 class="uh-carrito__subtitulo">
            {%- if cart.item_count > 0 -%}Completa tu decoración{%- else -%}Lo más pedido para Halloween{%- endif -%}
          </h2>
          <ul class="uh-sugerencias">{{ sugerencias }}</ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var form = document.querySelector('#uh-carrito-{{ section.id }} [data-uh-carrito-form]');
    if (!form) return;
    var enviar = function () {
      form.classList.add('is-actualizando');
      form.setAttribute('aria-busy', 'true');
      form.requestSubmit ? form.requestSubmit() : form.submit();
    };
    form.addEventListener('click', function (e) {
      var b = e.target.closest('[data-uh-menos], [data-uh-mas]');
      if (!b) return;
      var input = b.parentElement.querySelector('input');
      input.value = Math.max(0, (parseInt(input.value, 10) || 0) + (b.hasAttribute('data-uh-mas') ? 1 : -1));
      enviar();
    });
    form.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && e.target.matches('input[name="updates[]"]')) {
        e.preventDefault();
        enviar();
      }
    });
    form.addEventListener('change', function (e) {
      if (e.target.matches('input[name="updates[]"]')) enviar();
    });
  })();
</script>

{% schema %}
{
  "name": "Halloween · carrito",
  "tag": "div",
  "class": "uh-carrito-seccion",
  "settings": [
    { "type": "collection", "id": "coleccion", "label": "Colección para sugerencias", "info": "Si no eliges ninguna se usa la colección con el nombre de enlace halloween." },
    { "type": "text", "id": "envio", "label": "Línea de envío", "default": "Envío gratis a España, Francia y Alemania" },
    { "type": "text", "id": "plazo", "label": "Línea de plazo", "default": "Entrega estimada: 7 a 15 días laborables" }
  ],
  "presets": [{ "name": "Halloween · carrito" }]
}
{% endschema %}
